+function base32_encode_bytes(string $bin): string
+{
+    $out = '';
+    $bits = 0;
+    $buf = 0;
+    foreach (str_split($bin) as $ch) {
+        $buf = ($buf << 8) | ord($ch);
+        $bits += 8;
+        while ($bits >= 5) {
+            $bits -= 5;
+            $out .= KEY_ALPHABET[($buf >> $bits) & 31];
+        }
+        $buf &= (1 << $bits) - 1;
+    }
+    if ($bits > 0) $out .= KEY_ALPHABET[($buf << (5 - $bits)) & 31];
+    return $out;
